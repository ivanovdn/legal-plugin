# ── Backend runtime env for the VM (docker-compose.remote.yml) ──
# Spark box (172.20.0.22) is the shared AI/vector tier — Ollama LLM + embeddings AND Qdrant.
OLLAMA_BASE_URL=http://172.20.0.22:11434
# LLM_MODEL: match the model pulled on Spark. EMBEDDING_MODEL: must match what the
# legal_docs collection is built with (768-dim). Keep values comment-free — some
# compose env-file parsers do NOT strip inline `#` comments and fold them into the value.
LLM_MODEL=qwen3.6:latest
EMBEDDING_MODEL=embeddinggemma:latest
QDRANT_VECTOR_DIM=768

# Reuse Spark's Qdrant (legal-plugin's collections legal_docs/case_history/memory sit
# alongside compliance-bot's compliance_policies — separate namespaces). Omit the local
# qdrant service from `up` when this is set. Unset → falls back to a local qdrant container.
QDRANT_REMOTE_URL=http://172.20.0.22:6333

# App Postgres (app-db service) — must equal the app-db POSTGRES_PASSWORD.
APP_DB_PASSWORD=change-me

# Public hostname the add-in loads from (Caddy site address). Leave unset for
# local testing → Caddy uses "localhost" + an internal cert. On the VM set the
# real internal hostname (needs a trusted cert — see docs/deploy-vm.md, bucket B).
ADDIN_ORIGIN_HOST=legal-triage.internal.trinetix.net

# OTel tracing on the VM goes to the dedicated Phoenix service (docker-compose.remote.yml).
# No auth header needed. Leave OTEL_EXPORTER_OTLP_HEADERS unset.
OTEL_EXPORTER_OTLP_HEADERS=
