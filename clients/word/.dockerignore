# Installed inside the image by `npm ci` — copying the host's tree in would be
# slow and can carry platform-specific binaries that break the alpine build.
node_modules/

# Regenerated by `vite build`. Copying a stale host bundle in is exactly the
# drift this Dockerfile exists to eliminate.
dist/

# Not part of the served bundle: manifests are rendered separately by
# scripts/build_manifest.py and sideloaded, not served by Caddy.
manifest*.xml

README.md
sample-service-agreement.txt
*.log
.vite/
