# Global options (SP3, docs/superpowers/specs/2026-10-14-pane-activity-design.md).
# A machine that rejects our certificate leaves a trace ONLY at DEBUG, from the
# http.stdlib logger: "TLS handshake error from <ip>: … unknown certificate
# authority". This log keeps exactly that logger, so the DEBUG noise of every
# other module stays out. Files are 0644 so the deploy user reads them without
# sudo (data/caddy-logs/ on the host); rolled files are gzip-compressed.
{
	log tls_errors {
		output file /var/log/caddy/tls-errors.log {
			roll_size 10MiB
			roll_keep 10
			roll_keep_for 2160h
			mode 0644
		}
		format json
		level DEBUG
		include http.stdlib
	}
}

{$ADDIN_ORIGIN_HOST:localhost} {
	# Self-signed cert from Caddy's internal CA — works for localhost AND any
	# internal hostname (an internal-only VM can't complete public ACME).
	# Testers trust this CA via the dev-cert workaround. Replace with an explicit
	# `tls /etc/caddy/cert.pem /etc/caddy/key.pem` once IT issues a real cert
	# (see docs/deploy-vm.md Step 2).
	tls internal

	encode gzip

	# Every request to the site — pane loads, API calls, the ones turned away.
	# Authorization and Cookie values are logged as REDACTED (Caddy's default).
	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 10
			roll_keep_for 2160h
			mode 0644
		}
		format json
	}

	# Backend API — keep the /api prefix (backend routes are /api/*)
	handle /api/* {
		reverse_proxy backend:8000
	}

	# Everything else = the built task pane (fallback to taskpane.html)
	handle {
		root * /srv
		# Content-hashed asset filenames are immutable — cache them hard.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		# The HTML shell references the current asset hashes — never cache it, so a
		# redeploy reaches Word's WKWebView without users clearing their cache (the
		# Vite dev server sets the same header for the same reason).
		@notassets not path /assets/*
		header @notassets Cache-Control "no-store"
		try_files {path} /taskpane.html
		file_server
	}
}
